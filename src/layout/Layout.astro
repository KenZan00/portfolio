---
import "../styles/global.css";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

const { title = "Kenny"} = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
        <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="relative min-h-screen min-w-full flex flex-col bg-gray-50" >
        <div class="ibm-lines invisible"></div>
		<Header />
			<main class="flex-1 flex items-center justify-center max-w-5xl mx-auto px-6 md:px-12 relative z-10">
				<div class="max-w-5xl mx-auto flex-1">
					<slot />
				</div>
            </main>
		<Footer />
	</body>
</html>