---
const { project } = Astro.props;
---

<div class="flex flex-col gap-4">
    <p>Beskrivning: {project.description}</p>
    <a href={project.github} target="_blank" class="text-blue-500 hover:underline">Länk till projektet</a>
    <div class="flex flex-wrap gap-2">
        {project.tech.map((t : string) => (
            <span class="bg-gray-200 text-gray-800 px-2 py-1 rounded">{t}</span>
        ))}
    </div>
</div>