<form action="/api/contact-me" method="POST" class="flex flex-col gap-4 max-w-md mx-auto">
    <label for="email">Email:</label>
    <input type="email" id="email" name="email" placeholder="Ange email adress" required>

    <label for="message">Meddelande:</label>
    <textarea id="message" name="message" placeholder="Skriv ditt meddelande"></textarea>

    <button type="submit">Submit</button>
</form>
