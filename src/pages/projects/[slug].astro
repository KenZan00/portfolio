---
import { getCollection, render } from 'astro:content';
import Layout from '../../layout/Layout.astro';
import GithubIcon from "../../assets/github.svg";

export async function getStaticPaths() {
    const projects = await getCollection('projects');

    // console.log("PROJECT COUNT:", projects.length);
    // console.log("PROJECTS:", projects);

    return projects.map(project => ({
        params: { slug: project.id },
        props: { project }
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={project.data.title}>
    <h1 class="text-3xl font-bold mt-18 mb-6">{project.data.title}</h1>
    <p class="text-xl text-ibm-dark mb-6">{project.data.description}</p>
    <div class="flex items-center gap-4 mt-4">
        <a href={project.data.github}><GithubIcon class="w-8 h-8 text-ibm-blue hover:text-ibm-purple hover:scale-110 mb-6" /></a>
    </div>
    <hr class="border-ibm-dark opacity-50 mb-8 mt-6" />

    <div>{project.data.tech.map(tech => <img src={`/public/logos/${tech.toLowerCase()}.svg`} alt={tech} class="w-16 h-16 object-contain" />)}</div>


    <article class="prose prose-neutral max-w-none mt-12 mb-12">
        <Content />
    </article>
</Layout>