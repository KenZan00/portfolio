---
import { getCollection, render } from 'astro:content';
import Layout from '../../layout/Layout.astro';
import GithubIcon from "../../assets/github.svg";

export async function getStaticPaths() {
    const projects = await getCollection('projects');

    // console.log("PROJECT COUNT:", projects.length);
    // console.log("PROJECTS:", projects);

    return projects.map(project => ({
        params: { slug: project.id },
        props: { project }
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={project.data.title}>
    <div class="flex items-center flex-row justify-center gap-4 mt-24 mb-12">
        <h1 class="text-3xl font-bold">{project.data.title}</h1>
        <a href={project.data.github}><GithubIcon class="w-8 h-8 text-ibm-blue hover:text-ibm-purple hover:scale-110" /></a>
    </div>

    <p class="text-xl text-ibm-dark mb-6">{project.data.description}</p>
    <hr class="border-ibm-dark opacity-50 mb-8 mt-6" />

    <div class="flex justify-around my-24">{project.data.tech.map(tech => <img src={`/public/logos/${tech.toLowerCase()}.svg`} alt={tech} class="w-16 h-16 object-contain" />)}</div>


    <article class="prose prose-neutral max-w-none mt-12 mb-24">
        <Content />
    </article>
</Layout>